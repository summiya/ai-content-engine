# Copy this file to .env and fill in the values. NEVER share this file.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_CAPTION_MODEL=gpt-5-mini
AI_CAPTIONS=false

# Instagram API with Facebook Login: professional account ID, not @handle.
IG_USER_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v24.0
META_API_HOST=graph.facebook.com

# Cloudinary only serves images to Meta.
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

DAILY_COUNT=20
TIMEZONE=Asia/Dubai
POST_START_HOUR=8
POST_END_HOUR=22
AUTO_PUBLISH=false
# Optional transparent logo at assets/logo.png
WATERMARK_TEXT=SNJ INTERIORS
